# ── Environment ───────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
pip-wheel-metadata/
*.whl

# ── SQLite (local dev DB) ─────────────────────────────────────────────────────
*.db
*.db-shm
*.db-wal

# ── Pytest / Coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.log

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
frontend/dist/

# ── Docker ────────────────────────────────────────────────────────────────────
# keep docker-compose.yml tracked; ignore override files
docker-compose.override.yml

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Alembic ───────────────────────────────────────────────────────────────────
# keep versions/ tracked; ignore generated pyc inside alembic
backend/alembic/__pycache__/

# ── Misc ──────────────────────────────────────────────────────────────────────
*.bak
*.tmp
uvicorn.log
uvicorn.err
