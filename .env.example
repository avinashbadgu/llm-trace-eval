# Copy to .env and fill in your values
OPENAI_API_KEY=sk-...

# Database (used by backend & worker)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/llmeval

# Redis (used by backend & ARQ worker)
REDIS_URL=redis://localhost:6379

# CORS — add your frontend origin
CORS_ORIGINS=http://localhost:5173

# ARQ worker tuning
ARQ_MAX_JOBS=4
ARQ_JOB_TIMEOUT=120
